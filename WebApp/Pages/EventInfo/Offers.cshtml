@page
@model WebApp.Pages.EventInfo.OffersModel
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid w-100 mt-5 fw-bolder">
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-5 w-100">
			<div class="card shadow">
				<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
					<h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Offers</h5>
				</div>
				<div class="card-body">
					<form method="post">
						<input type="hidden" asp-for="@Model.model.OfferId" />
						<div class="mb-3">
							<label for="EventSelect" class="form-label">Event</label>
							<select asp-for="@Model.model.EventId" class="form-control" id="EventId" required>
								<option value="">Select an Event</option>
								@foreach (var item in Model.events)
								{
									<option value="@item.EventId">@item.EventName</option>
								}
							</select>
						</div>
						<div class="mb-3">
							<label for="EventSelect" class="form-label">Package</label>
							<select asp-for="@Model.model.PackageId" class="form-control" id="PackageId" required>
								<option value="">Select an Package</option>
								@foreach (var item in Model.packages)
								{
									<option value="@item.PackageId">@item.PackageName</option>
								}
							</select>
						</div>

						<div class="mb-3">
							<label for="Price" class="form-label">Name</label>
							<input asp-for="@Model.model.OfferName" class="form-control" id="Name" placeholder="Enter Offer Name" required />
						</div>
						<div class="mb-3">
							<label for="Description" class="form-label">Description</label>
							<textarea asp-for="@Model.model.OfferDescription"
									  class="form-control"
									  id="Description"
									  placeholder="Enter Offer Description"
									  rows="4"
									  required></textarea>
						</div>
						<div class="mb-3">
							<label for="Price" class="form-label">Price</label>
							<input asp-for="@Model.model.OfferPrice" type="number" class="form-control" id="Price" placeholder="Enter Offer Price" required />
						</div>
						<button type="submit" class="btn btn-success w-100">
							<i class="bi bi-check-circle me-1"></i> Save Changes
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
