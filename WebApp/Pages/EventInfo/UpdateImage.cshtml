@page
@model WebApp.Pages.EventInfo.UpdateImageModel
@{
    Layout = "MyLayout";
}


<div class="container mt-5">
    <!-- Display Success/Error Messages -->
    <div class="p-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success fade show" role="alert">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger fade show" role="alert">
                @TempData["Error"]
            </div>
        }
    </div>

    <!-- Event Image Update Section -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg rounded-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>@Model.events.EventName Images</h5>
                </div>

                <div class="card-body">
                    @if (Model.ExistingImages?.Count > 0)
                    {
                        <div class="mb-4">
                            <label class="form-label fs-4">Uploaded Images</label>
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                @foreach (var image in Model.ExistingImages)
                                {
                                    <div class="col">
                                        <div class="card shadow-sm">
                                            <img src="/@image.ImagePath" alt="Event Image" class="card-img-top preview-img rounded-3" />
                                            <div class="card-body text-center">
                                                <form method="post">
                                                    <input type="hidden" name="Id" value="@Model.Id" />
                                                    <input type="hidden" name="ImagePath" value="@image.ImagePath" />
                                                    <input type="hidden" name="ImageId" value="@image.ImageId" />
                                                    <button type="submit" class="btn btn-danger btn-sm w-100" formaction="@Url.Page("/EventInfo/UpdateImage", new { handler = "DeleteImage", imagePath = image.ImagePath, imageId = image.ImageId })">
                                                        <i class="bi bi-x-circle"></i> Remove
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No images uploaded yet.</p>
                    }
                </div>

                <!-- Add Image/Update Event Link -->
                <div class="card-footer text-center">
                    <a class="btn btn-outline-primary w-100" href="/EventInfo/Events?Id=@Model.events.EventId">
                        <i class="bi bi-upload me-2"></i> Add New Image/Update Event
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Smooth Fade-Out for Alerts -->
<script>
    setTimeout(function () {
        const alertEl = document.querySelector(".alert");
        if (alertEl) {
            alertEl.style.transition = "opacity 0.5s ease-out";
            alertEl.style.opacity = "0";
            setTimeout(() => alertEl.remove(), 500); // Remove after fade
        }
    }, 4000); // Fade after 4 seconds
</script>

<!-- Custom Styles for Images -->
<style>
    .preview-img {
        max-height: 200px; /* Uniform height for images */
        object-fit: cover;
        border-radius: 8px;
    }

    .card-body {
        padding: 1rem;
    }

    .alert {
        transition: opacity 0.5s ease-out;
    }

    .btn-outline-primary {
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .card-header {
        background-color: #007bff; /* Primary blue color */
    }

    .card-footer {
        background-color: #f8f9fa;
    }

    .card:hover {
        transform: scale(1.05);
        transition: transform 0.2s ease-in-out;
    }
</style>
