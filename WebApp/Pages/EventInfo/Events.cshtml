@page
@model WebApp.Pages.EventInfo.EventsModel
@{
    Layout = "_Layout";
}

<div class="p-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Events</h5>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="@Model.model.EventId" />

                        <div class="mb-3">
                            <label for="Name" class="form-label">Name</label>
                            <input asp-for="@Model.model.EventName" class="form-control" id="Name" placeholder="Enter Event name" required />
                        </div>

                        <div class="mb-3">
                            <label for="Standard" class="form-label">Standard</label>
                            <select asp-for="@Model.model.StandardId" class="form-control" id="StandardId" required>
                                <option value="">Select Standard</option>
                                @foreach (var standard in Model.standards)
                                {
                                    <option value="@standard.StandardId">@standard.StandardName</option>
                                }
                            </select>
                        </div>
                        @if (Model.ExistingImages?.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Uploaded Images</label>
                                <div class="row g-3">
                                    @foreach (var image in Model.ExistingImages)
                                    {
                                        <div class="col-6 col-md-4 col-lg-3 d-flex justify-content-center">
                                            <img src="/@image.ImagePath" alt="Event Image"
                                                 class="img-fluid rounded shadow-sm preview-img" />
                                        </div>
                                    }
                                </div>

                                <a class="link btn btn-info btn-lg rounded-pill shadow-sm mt-3"
                                   asp-page="/EventInfo/UpdateImage"
                                   asp-route-Id="@Model.model.EventId"
                                   role="button">
                                    <i class="fas fa-image"></i> Update Images
                                </a>
                            </div>
                        }

                        @* New Image Upload Section *@
                        <div class="mb-3">
                            <label for="Images" class="form-label">Upload New Images</label>
                            <input type="file" asp-for="Images" multiple class="form-control" id="Images" />
                        </div>

                        <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-3">
                            <!-- Preview selected images here -->
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const imageInput = document.getElementById('Images');
    const imagePreview = document.getElementById('imagePreview');
    let selectedFiles = [];

    imageInput.addEventListener('change', handleFileSelect);

    function handleFileSelect(event) {
        const files = event.target.files;
        imagePreview.innerHTML = '';  // Clear existing previews

        selectedFiles = Array.from(files);

        selectedFiles.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function (e) {
                const imageElement = document.createElement('div');
                imageElement.classList.add('image-container', 'position-relative');

                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = 'Preview Image';
                img.classList.add('img-thumbnail', 'preview-img');

                // Create remove button for the preview image
                const removeBtn = document.createElement('button');
                removeBtn.classList.add('btn', 'btn-danger', 'btn-sm', 'w-100');
                removeBtn.innerHTML = 'Remove';
                removeBtn.onclick = function () {
                    removePreviewImage(index);
                };

                // Append image and remove button to the container
                imageElement.appendChild(img);
                imageElement.appendChild(removeBtn);
                imagePreview.appendChild(imageElement);
            };
            reader.readAsDataURL(file);
        });
    }

    // Remove preview image logic
    function removePreviewImage(index) {
        selectedFiles.splice(index, 1);  // Remove the file from the selected files array

        // Update the file input with the remaining files
        const dataTransfer = new DataTransfer();
        selectedFiles.forEach(file => dataTransfer.items.add(file));
        imageInput.files = dataTransfer.files;

        // Re-render the preview images
        handleFileSelect({ target: { files: imageInput.files } });
    }
</script>

<style>
    .preview-img {
        max-width: 200px; /* limit max size */
        max-height: 200px;
        object-fit: cover;
        width: 100%; /* Ensure the image fills the width of its container */
        height: 120px; /* Fixed height to maintain uniformity */
        border-radius: 8px;
        margin-bottom: 10px; /* Space between image and buttons */
    }

    .image-container {
        margin-bottom: 20px; /* Space between each image container */
        text-align: center; /* Center the buttons */
    }

    button {
        margin-top: 10px; /* Add space between the image and the buttons */
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between; /* Distribute images evenly across the row */
    }

    .col-4 {
        width: 32%; /* 3 images per row, adjust width accordingly */
        margin-bottom: 20px; /* Space between the rows */
    }
</style>
