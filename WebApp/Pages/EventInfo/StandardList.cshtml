@page
@model WebApp.Pages.EventInfo.StandardListModel
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<a class="btn btn-primary mb-3 " asp-area="" asp-page="/EventInfo/Standard">Add New Standard</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Serial</th>
            <th>Standard Name</th>
			<th>Created Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.List != null && Model.List.Any())
        {
            foreach (var item in Model.List)
            {
                <tr>
                    <td>@item.StandardId</td>
                    <td>@item.StandardName</td>
                    <td>@item.CreatedDate</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/EventInfo/Standard" asp-route-Id="@item.StandardId">
                            @* <i class="bi bi-pencil-square"></i> Edit *@
                            <i class="bi bi-pen"></i>
                        </a>
                        <form method="post" asp-page-handler="DeleteEvent" asp-route-id="@item.StandardId" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No Standards available.</td>
            </tr>
        }
    </tbody>
</table>