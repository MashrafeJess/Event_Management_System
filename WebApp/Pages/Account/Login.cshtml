@page
@model WebApp.Pages.Account.LoginModel
@{
    Layout = "MyLayout";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(to right, #6A11CB, #2575FC);
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-box {
            background-color: #ffffff;
            padding: 40px 35px;
            border-radius: 15px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
            max-width: 420px;
            width: 100%;
        }

        .login-header {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 500;
        }

        .form-control {
            border-radius: 8px;
        }

        .login-button {
            background-color: #2575FC;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

            .login-button:hover {
                background-color: #1a5edc;
            }

        .login-footer {
            text-align: center;
            margin-top: 20px;
        }

            .login-footer a {
                display: block;
                color: #444;
                margin-top: 8px;
                text-decoration: none;
                font-size: 14px;
            }

                .login-footer a:hover {
                    text-decoration: underline;
                }
    </style>
}

<div class="login-container">
    <div class="login-box">
        <h2 class="login-header">Sign In</h2>
        <form method="post" novalidate>
            <div class="mb-3">
                <label asp-for="loginForm.Email" class="form-label">Email address</label>
                <input asp-for="loginForm.Email" class="form-control" placeholder="Enter email" />
                <span asp-validation-for="loginForm.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="loginForm.Password" class="form-label">Password</label>
                <input asp-for="loginForm.Password" type="password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="loginForm.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="login-button">Login</button>
        </form>
        <div class="login-footer">
            <a href="/Account/Registration">Don't have an account? Sign Up</a>
            <a href="/Account/ResetLink">Forgot Password? Reset Here</a>
        </div>
    </div>
    <div class="p-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector(".alert");
            if (alertEl) {
                alertEl.style.transition = "opacity 0.5s ease-out";
                alertEl.style.opacity = "0";
                setTimeout(() => alertEl.remove(), 500); // remove after fade
            }
        }, 4000); // 4 seconds
    </script>
}