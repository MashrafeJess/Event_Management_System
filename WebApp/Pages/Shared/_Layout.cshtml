﻿@using System.Security.Claims
@{
    string role = User.Identity.IsAuthenticated ? User.FindFirst(ClaimTypes.Role)?.Value : null;
    bool isAuthenticated = User.Identity.IsAuthenticated;
}
@inject CartService cartService

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var cartCount = userId != null ? cartService.GetCartCountByUserId(userId) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pages/Shared/Layout.cshtml.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
       
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <nav class="navbar bg-dark border-bottom border-body sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">WeddingVerse</a>
            <div class="d-flex align-items-center text-light ms-auto">
                @if(isAuthenticated)
                {
                    <div class="px-3">@User.Identity.Name</div>
                    <div class="px-3" asp-page="/Account/Login" asp-page-handler="Logout">Log Out</div>
                }
                else
                {
                    <div class="px-3" asp-page="/Account/Login">Log In</div>
				}
            </div>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNavDropdown"
                    aria-controls="navbarNavDropdown"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavDropdown">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active text-black" aria-current="page" asp-page="/Index">Homepage</a>
                    </li>
                    @if(isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Dashboard">Dashboard</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Login">Log In</a>
                        </li>
                    }
                    @if(isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="#">Account Settings</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="#">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Offers</a>
                    </li>
                    @if(isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="#">Book an Appointment</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Book an Appointment</a>
                        </li>
                    }
                    @if(isAuthenticated && (role == "1" || role== "2"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Settings
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/EventInfo/EventList">Add Events</a></li>
                                <li><a class="dropdown-item" href="/EventInfo/PackageList">Add Packages</a></li>
                                <li><a class="dropdown-item" href="/EventInfo/OfferList">Add Offer</a></li>
                                <li><a class="dropdown-item" href="/EventInfo/AllOrderList">All Orders</a></li>
                                <li><a class="dropdown-item" href="/EventInfo/StandarList">Add Standard</a></li>
                                @if(role == "1")
                                {
                                    <li><a class="dropdown-item" href="/Account/AddminsAccess">Admins Access</a></li>
								}
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <footer class="border-top footer text-muted bg_color">
        <div class="container">
            &copy; 2024 - Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
        <div class="container">
            <p class="text-blue">developed by Mashrafe</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>