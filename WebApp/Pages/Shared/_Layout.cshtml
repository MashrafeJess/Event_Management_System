﻿@using System.Security.Claims
@{
    string role = User.Identity.IsAuthenticated ? User.FindFirst(ClaimTypes.Role)?.Value : null;
    bool isAuthenticated = User.Identity.IsAuthenticated;
}
@inject CartService cartService
@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var cartCount = userId != null ? cartService.GetCartCountByUserId(userId) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WebApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pages/Shared/Layout.cshtml.css" asp-append-version="true" /> *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="top">
        <nav class="navbar bg-dark border-bottom border-body" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">WeddingVerse</a>
                <div class="d-flex align-items-center text-light ms-auto">
                    @if (isAuthenticated)
                    {
                        <div class="px-3">@User.Identity.Name</div>
                        <a class="px-3" asp-page="/Account/Login" asp-page-handler="Logout">Log Out</a>
                    }
                    else
                    {
                        <a class="px-3" asp-page="/Account/Login">Log In</a>
                    }
                </div>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNavDropdown"
                        aria-controls="navbarNavDropdown"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link active text-light" aria-current="page" asp-page="/Index">Homepage</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Dashboard">Dashboard</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">Log In</a>
                            </li>
                        }
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Update">Account Settings</a>
                            </li>
                        }
                        @if (isAuthenticated && (role == "3"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Service/CartList">Cart</a>
                            </li>
                        }
                        @if (isAuthenticated && (role == "3"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/EventInfo/EventList">Events</a>
                            </li>
                        }
						@if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/LogIn">Events</a>
                            </li>
                        }
                        @if (isAuthenticated && (role == "3"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/EventInfo/OffersList">Offers</a>
                            </li>
                        }
                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Offers</a>
                            </li>
                        }
                        
                        @if (isAuthenticated && (role == "3"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Service/BookOfferDirect">Book an Appointment</a>
                            </li>
                        }
                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Book an Appointment</a>
                            </li>
                        }
                        @if (isAuthenticated && (role == "1" || role == "2"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Settings
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/EventInfo/StandardList">Add Standard</a></li>
                                    <li><a class="dropdown-item" href="/EventInfo/EventList">Add Events</a></li>
                                    <li><a class="dropdown-item" href="/EventInfo/PackageList">Add Packages</a></li>
                                    <li><a class="dropdown-item" href="/EventInfo/OffersList">Add Offer</a></li>
                                    <li><a class="dropdown-item" href="/EventInfo/AllOrderList">All Orders</a></li>
                                    @if (role == "1")
                                    {
                                        <li><a class="dropdown-item" href="/Account/AdminsAccess">Admins Access</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 border-top foot">
        <div class="col-md-4 d-flex align-items-center">
            <a href="/" class="mb-3 me-2 mb-md-0 text-muted text-decoration-none lh-1">
                <svg class="bi" width="30" height="24"><use xlink:href="#bootstrap"></use></svg>
            </a>
            <span class="mb-3 mb-md-0  text-light">© 2022 WeddingVerse, Inc</span>
        </div>
        <b>Developed by Mashrafe</b>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>