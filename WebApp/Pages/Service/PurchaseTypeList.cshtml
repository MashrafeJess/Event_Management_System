@page
@model WebApp.Pages.Service.PurchaseTypeListModel
@{
    Layout = "_Layout";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="text-center fs-1 fw-bold mb-5">
    All offers of @Model.List.First().PackageName Package
</div>

<div class="container">
    <div class="row g-4 justify-content-center">
        @if (Model.List != null && Model.List.Any())
        {
            foreach (var offers in Model.List)
            {
                <div class="col-12 col-sm-6 col-md-6 col-lg-4">
                    <div class="bg-info text-center text-white fw-bold shadow rounded-4 h-100 p-4 d-flex flex-column justify-content-between">

                        <!-- Offer Name -->
                        <h3 class="fs-3 mb-3 text-wrap text-break offer-title">
                            @offers.OfferName
                        </h3>

                        <!-- Button + Collapse -->
                        <div>
                            <a class="btn btn-warning mt-auto" data-bs-toggle="collapse" href="#collapse-@offers.OfferId" role="button" aria-expanded="false" aria-controls="collapse-@offers.OfferId">
                                Offer Details
                            </a>
                            <div class="collapse mt-2 text-black" id="collapse-@offers.OfferId">
                                <div class="card card-body" style="white-space: pre-line;">
                                    @offers.OfferDescription
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="fs-4 text-muted">No offers available.</p>
            </div>
        }
    </div>
</div>

<style>
    /* Limit title to max 2 lines with ellipsis (...) */
    .offer-title {
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Show max 2 lines */
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-wrap: break-word;
    }
</style>
