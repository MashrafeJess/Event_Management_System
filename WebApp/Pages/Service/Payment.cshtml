@page
@model WebApp.Pages.Service.PaymentModel
@{
    Layout = "_Layout"; // use your site layout; remove if standalone
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .payment-card {
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease;
    }

        .payment-card.selected {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
        }

    .card-brand {
        font-weight: 700;
        letter-spacing: .6px
    }

    .small-muted {
        font-size: .85rem;
        color: #6c757d
    }

    .qr-placeholder {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg,#eee,#ddd);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px
    }
</style>

<div class="container py-5">
    <div class="row g-4">
        <!-- Payment methods -->
        <div class="col-lg-6">
            <div class="card p-4">
                <h5 class="mb-3">Select payment method</h5>
                <div class="d-flex gap-3 mb-3">
                    <div class="payment-card card p-2 text-center w-100" data-method="bkash">
                        <div class="card-body">
                            <i class="bi bi-phone-fill fs-1 text-danger"></i>
                            <div class="card-brand mt-2">bKash</div>
                            <div class="small-muted">Mobile Wallet</div>
                        </div>
                    </div>
                    <div class="payment-card card p-2 text-center w-100" data-method="nagad">
                        <div class="card-body">
                            <i class="bi bi-wallet2 fs-1 text-success"></i>
                            <div class="card-brand mt-2">Nagad</div>
                            <div class="small-muted">Mobile Wallet</div>
                        </div>
                    </div>
                    <div class="payment-card card p-2 text-center w-100" data-method="visa">
                        <div class="card-body">
                            <i class="bi bi-credit-card-2-front-fill fs-1 text-primary"></i>
                            <div class="card-brand mt-2">Card (Visa / MC)</div>
                            <div class="small-muted">Debit / Credit</div>
                        </div>
                    </div>
                </div>

                <!-- Payment forms -->
                <div id="payment-forms">
                    @* --- bKash --- *@
                    <div id="form-bkash" class="payment-form d-none">
                        <form id="bkash-pay-form">
                            <div class="mb-3">
                                <label class="form-label">Sender Mobile Number</label>
                                <input type="tel" class="form-control" id="bkashSender" placeholder="01XXXXXXXXX" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Transaction ID (TXN)</label>
                                <input class="form-control" id="bkashTxn" placeholder="Enter transaction id from app" required>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Amount</small>
                                    <div class="fw-bold">৳ <span id="amount-bkash">0.00</span></div>
                                </div>
                                <button type="submit" class="btn btn-danger">Confirm Payment</button>
                            </div>
                        </form>
                    </div>

                    @* --- Nagad --- *@
                    <div id="form-nagad" class="payment-form d-none">
                        <form id="nagad-pay-form">
                            <div class="mb-3">
                                <label class="form-label">Sender Mobile Number</label>
                                <input type="tel" class="form-control" id="nagadSender" placeholder="01XXXXXXXXX" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Transaction ID (TXN)</label>
                                <input class="form-control" id="nagadTxn" placeholder="Enter transaction id from app" required>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Amount</small>
                                    <div class="fw-bold">৳ <span id="amount-nagad">0.00</span></div>
                                </div>
                                <button type="submit" class="btn btn-success">Confirm Payment</button>
                            </div>
                        </form>
                    </div>

                    @* --- Visa / MC --- *@
                    <div id="form-visa" class="payment-form d-none">
                        <form id="card-pay-form">
                            <div class="mb-3">
                                <label class="form-label">Name on card</label>
                                <input type="text" class="form-control" id="cardName" placeholder="Full name as on card" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Card number</label>
                                <input type="text" class="form-control" id="cardNumber" maxlength="19" placeholder="xxxx xxxx xxxx xxxx" required>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label">Expiry (MM/YY)</label>
                                    <input type="text" class="form-control" id="cardExpiry" maxlength="5" placeholder="MM/YY" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">CVV</label>
                                    <input type="password" class="form-control" id="cardCvv" maxlength="4" placeholder="123" required>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Amount</small>
                                    <div class="fw-bold">৳ <span id="amount-card">0.00</span></div>
                                </div>
                                <button type="submit" class="btn btn-primary">Pay with Card</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="mt-3 text-muted small">Supported: bKash, Nagad, Visa, Mastercard</div>
        </div>

        <!-- Order summary -->
        <div class="col-lg-6">
            <div class="card p-4">
                <h5>Order summary</h5>
                <div class="d-flex justify-content-between mt-3">
                    <div>Subtotal</div>
                    <div>৳ <span id="summary-sub">0.00</span></div>
                </div>
                <div class="d-flex justify-content-between">
                    <div>Shipping</div>
                    <div>৳ <span id="summary-ship">0.00</span></div>
                </div>
                <hr>
                <div class="d-flex justify-content-between fs-5 fw-bold">
                    <div>Total</div>
                    <div>৳ <span id="summary-total">0.00</span></div>
                </div>
                <div class="mt-3">
                    <label class="form-label">Enter amount to pay</label>
                    <input type="number" id="input-amount" class="form-control" min="0" step="0.01" value="100.00">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="confirm-text">Please confirm your payment.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirm-pay" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const cards = document.querySelectorAll('.payment-card');
    const forms = {
        bkash: document.getElementById('form-bkash'),
        nagad: document.getElementById('form-nagad'),
        visa: document.getElementById('form-visa')
    };
    let selected = null;

    function selectMethod(name) {
        selected = name;
        cards.forEach(c => c.classList.toggle('selected', c.dataset.method === name));
        Object.values(forms).forEach(f => f.classList.add('d-none'));
        forms[name].classList.remove('d-none');
        syncAmounts();
    }

    cards.forEach(c => c.addEventListener('click', () => selectMethod(c.dataset.method)));
    selectMethod('bkash'); // default

    const inputAmount = document.getElementById('input-amount');
    function syncAmounts() {
        const v = parseFloat(inputAmount.value || 0).toFixed(2);
        document.getElementById('amount-bkash').textContent = v;
        document.getElementById('amount-nagad').textContent = v;
        document.getElementById('amount-card').textContent = v;
        document.getElementById('summary-sub').textContent = v;
        document.getElementById('summary-ship').textContent = '0.00';
        document.getElementById('summary-total').textContent = v;
    }
    inputAmount.addEventListener('input', syncAmounts);
    syncAmounts();

    const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
    document.getElementById('bkash-pay-form').addEventListener('submit', e => {
        e.preventDefault();
        document.getElementById('confirm-text').textContent = `Pay ৳${document.getElementById('amount-bkash').textContent} with bKash. Confirm?`;
        confirmModal.show();
    });
    document.getElementById('nagad-pay-form').addEventListener('submit', e => {
        e.preventDefault();
        document.getElementById('confirm-text').textContent = `Pay ৳${document.getElementById('amount-nagad').textContent} with Nagad. Confirm?`;
        confirmModal.show();
    });
    document.getElementById('card-pay-form').addEventListener('submit', e => {
        e.preventDefault();
        document.getElementById('confirm-text').textContent = `Pay ৳${document.getElementById('amount-card').textContent} with Card. Confirm?`;
        confirmModal.show();
    });

    document.getElementById('confirm-pay').addEventListener('click', () => {
        confirmModal.hide();
        const payload = { method: selected, amount: parseFloat(inputAmount.value || 0) };
        alert('Send to server: ' + JSON.stringify(payload));
        // TODO: call your backend API securely
    });
</script>
