@page
@model WebApp.Pages.Service.CartListModel
@{
    Layout = "_Layout";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-lg wide-container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-cart me-2"></i> Your Cart</h5>
        </div>
        <div class="card-body p-0 w-100">
            <div class="table-responsive w-100">
                <table class="table table-bordered table-hover mb-0 text-center align-middle small w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Event Name</th>
                            <th>Package Name</th>
                            <th>Offer Name</th>
                            <th>Price</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Check Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.cart != null && Model.cart.Any())
                        {
                            foreach (var item in Model.cart)
                            {
                                <tr class="text-wrap">
                                    <td>@item.EventName</td>
                                    <td>@item.PackageName</td>
                                    <td>@item.OfferName</td>
                                    <td class="fw-bold text-danger">@item.Price BDT</td>
                                    <td>@item.Location</td>
                                    <td>@item.EventDate?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="/Service/BookOfferDirect"
                                           asp-route-cartId="@item.CartId">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                    </td>

                                    <td>
                                        <form method="post"
                                              asp-page-handler="Done"
                                              asp-route-id="@item.CartId"
                                              asp-page="/Service/Payment">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-circle-fill"></i> Done
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-cart-x fs-4"></i> No events available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
